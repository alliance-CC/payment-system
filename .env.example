# ============================================================
# Memoreal Payments (継続課金 決済アプリ)
# Vercel: Settings → Environment Variables に同じキーで登録
# DB は当面 CRM と同じ Supabase を共有する (将来は別プロジェクトへ分離)
# ============================================================

# --- Supabase (必須。CRM と同じプロジェクトを指す) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # 公開申込/Cron は service_role で書き込む

# --- アプリ ------------------------------------------------
NEXT_PUBLIC_APP_NAME="Memoreal"
NEXT_PUBLIC_APP_URL=https://YOUR-PAYMENTS-APP.vercel.app

# ============================================================
# VeriTrans 4G (継続課金 / OPEN API)
# 3値はテスト利用情報通知書に記載。秘密鍵は絶対にコミットしない。
# DB(integrations テーブル)にテナント別で入れれば env より優先される。
# ============================================================
VT_PRODUCTION=false                 # true で本番(/paynow)、false で検証(/test-paynow)
VT_MERCHANT_CCID=                   # Merchant CCID (サーバー専用)
VT_MERCHANT_KEY=                    # authHash 用秘密鍵 (サーバー専用・非公開)
VT_TOKEN_API_KEY=                   # ブラウザ /4gtoken 用 (公開可)

# --- 継続課金の運用設定 ------------------------------------
PAYMENTS_FREE_MONTHS=2              # 無料期間(申込月含むヶ月数)。2=申込月+翌月無料→翌々月1日課金。0で即時課金
# VT_PLANS_JSON=[{"id":"plus","name":"暮らし安心プラス","amount":1200,"cycle":"monthly"},{"id":"premium","name":"暮らし安心プレミアム","amount":1700,"cycle":"monthly"}]
# VT_RETRY_INTERVALS_DAYS=1,3,7     # 失敗リトライ間隔(日)
# VT_RETRY_MAX=3                    # リトライ上限。超過で停止
# VT_CARD_EXPIRED_CODES=            # カード期限切れと判定する vResultCode プレフィックス(カンマ区切り)
# VT_CRON_BATCH_LIMIT=200           # 1回のCronで課金する最大契約数
# VT_USE_3DS=false                  # 3DS(/Authorize/mpi) を有効化
PAYMENTS_TERMS_VERSION=2026-07-01 # 同意記録に残す規約バージョン(確定版の制定日)。改定時に更新
PAYMENTS_NOTIFY_EMAIL=alliance@lifeap.co  # 申込時の通知先 (SMTP設定が必要。カード情報は含めない)
# PAYMENTS_DEFAULT_TENANT_ID=       # 公開申込の既定テナントUUID
CRON_SECRET=please-change-me        # Vercel Cron の認可 (Authorization: Bearer)

# --- 管理ボード (登録者管理・認証) -------------------------
ADMIN_PASSWORD=                     # 管理ボード(/admin)のログインパスワード (必須。未設定なら誰も入れない)
# ADMIN_SESSION_SECRET=            # セッション署名鍵 (任意。未設定なら ADMIN_PASSWORD から導出)

# --- 申込データのスプレッドシート追記 (任意) ----------------
# PAYMENTS_SIGNUP_SHEET_ID=         # 未設定時は GOOGLE_SHEETS_TARGET_SPREADSHEET_ID
# PAYMENTS_SIGNUP_SHEET_TAB=申込
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_TARGET_SPREADSHEET_ID=

# --- メール送信: Resend (推奨・無料枠あり) ------------------
# RESEND_API_KEY があれば Resend で送信、無ければ下の SMTP にフォールバック。
# Resend で送信ドメイン(lifeap.co)を認証 → APIキー発行。無料枠 100通/日・3000通/月。
RESEND_API_KEY=
RESEND_FROM="暮らし安心 <no-reply@lifeap.co>"   # 差出人 (認証済みドメインのアドレス)

# --- SMTP (通知メール送信・任意。Resend 未設定時のフォールバック) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
